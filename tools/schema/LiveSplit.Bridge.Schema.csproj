<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefineConstants>$(DefineConstants);SCHEMA_GENERATION</DefineConstants>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="ContractSamples/**/*.cs" />
    <Compile Include="../../src/LiveSplit.Bridge.Json/Models.cs" Link="Models.cs" />
    <PackageReference Include="JsonSchema.Net.Generation" Version="7.3.11" />
    <PackageReference Include="JsonSchema.Net.Generation.DataAnnotations" Version="3.1.1" />
  </ItemGroup>
</Project>
