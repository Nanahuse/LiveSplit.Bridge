<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference
      Include="..\..\external\LiveSplit\src\LiveSplit.Core\LiveSplit.Core.csproj"
      Private="false" />

    <ProjectReference
      Include="..\..\external\LiveSplit\src\UpdateManager\UpdateManager.csproj"
      Private="false" />

    <ProjectReference
      Include="..\LiveSplit.Bridge.Protocol\LiveSplit.Bridge.Protocol.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net4.8.1</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>

    <AssemblyName>LiveSplit.Bridge</AssemblyName>
    <RootNamespace>LiveSplit.Bridge</RootNamespace>
  </PropertyGroup>

  <Target Name="DeployToLiveSplit" AfterTargets="Build">
    <MakeDir Directories="$(LiveSplitComponentsPath)" />

    <ItemGroup>
      <BridgeDeployFiles Include="$(TargetPath)" />

      <BridgeDeployFiles
        Include="$(TargetDir)LiveSplit.Bridge.pdb"
        Condition="Exists('$(TargetDir)LiveSplit.Bridge.pdb')" />

      <BridgeDeployFiles
        Include="$(TargetDir)LiveSplit.Bridge.Protocol.dll"
        Condition="Exists('$(TargetDir)LiveSplit.Bridge.Protocol.dll')" />

      <BridgeDeployFiles
        Include="$(TargetDir)LiveSplit.Bridge.Protocol.pdb"
        Condition="Exists('$(TargetDir)LiveSplit.Bridge.Protocol.pdb')" />
    </ItemGroup>

    <Copy
      SourceFiles="@(BridgeDeployFiles)"
      DestinationFolder="$(LiveSplitComponentsPath)"
      SkipUnchangedFiles="true" />
  </Target>
</Project>