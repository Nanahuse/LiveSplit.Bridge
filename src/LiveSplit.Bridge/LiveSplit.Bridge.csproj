<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference
      Include="..\..\external\LiveSplit\src\LiveSplit.Core\LiveSplit.Core.csproj"
      Private="false" />

    <ProjectReference
      Include="..\..\external\LiveSplit\src\UpdateManager\UpdateManager.csproj"
      Private="false" />

    <ProjectReference
      Include="..\LiveSplit.Bridge.Protocol\LiveSplit.Bridge.Protocol.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net4.8.1</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>

    <AssemblyName>LiveSplit.Bridge</AssemblyName>
    <RootNamespace>LiveSplit.Bridge</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NetMQ" Version="4.0.4.3" />
  </ItemGroup>

  <Target Name="DeployToLiveSplit" AfterTargets="Build">
    <MakeDir Directories="$(LiveSplitComponentsPath)" />

    <ItemGroup>
      <BridgeDeployFiles Include="$(TargetDir)*.dll;$(TargetDir)*.pdb" />
      <LiveSplitRootDependencyFiles Include="$(LiveSplitComponentsPath)\System.*.dll" />
      <LiveSplitRootDependencyFiles
        Include="$(LiveSplitComponentsPath)\Microsoft.Bcl.AsyncInterfaces.dll" />
      <LiveSplitRootDependencyFiles Include="$(LiveSplitComponentsPath)\Microsoft.Web.WebView2*.dll" />
      <LiveSplitRootDependencyFiles Include="$(LiveSplitComponentsPath)\WinFormsColor.dll" />
      <LiveSplitRootDependencyFiles Include="$(LiveSplitComponentsPath)\Ookii.Dialogs.WinForms.dll" />
      <LiveSplitRootDependencyFiles Include="$(LiveSplitComponentsPath)\NetMQ.dll" />
      <LiveSplitRootDependencyFiles Include="$(LiveSplitComponentsPath)\Google.Protobuf.dll" />
      <LiveSplitRootDependencyFiles Include="$(LiveSplitComponentsPath)\SpeedrunComSharp.dll" />
      <LiveSplitRootDependencyFiles Include="$(LiveSplitComponentsPath)\websocket-sharp.dll" />
      <LiveSplitConfigFiles Include="LiveSplit.exe.config" />
    </ItemGroup>

    <Copy
      SourceFiles="@(BridgeDeployFiles)"
      DestinationFolder="$(LiveSplitComponentsPath)"
      SkipUnchangedFiles="true" />

    <Copy
      SourceFiles="@(LiveSplitRootDependencyFiles)"
      DestinationFolder="$(LiveSplitBuildPath)"
      SkipUnchangedFiles="true" />

    <Copy
      SourceFiles="@(LiveSplitConfigFiles)"
      DestinationFolder="$(LiveSplitBuildPath)"
      SkipUnchangedFiles="true" />
  </Target>
</Project>