<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference
      Include="..\..\external\LiveSplit\src\LiveSplit.Core\LiveSplit.Core.csproj"
      Private="false"
      ExcludeAssets="runtime" />

    <ProjectReference
      Include="..\..\external\LiveSplit\src\UpdateManager\UpdateManager.csproj"
      Private="false"
      ExcludeAssets="runtime" />

  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net4.8.1</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>

    <AssemblyName>LiveSplit.Bridge</AssemblyName>
    <RootNamespace>LiveSplit.Bridge</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\LiveSplit.Bridge.Json\Models.cs" Link="Json\Models.cs" />
    <Compile Include="..\LiveSplit.Bridge.Json\SerializerOptions.cs" Link="Json\SerializerOptions.cs" />
    <Compile Include="..\LiveSplit.Bridge.Json\SnapshotOperations.cs" Link="Json\SnapshotOperations.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="9.0.4" />
  </ItemGroup>

  <Target Name="DeployToLiveSplit" AfterTargets="Build">
    <MakeDir Directories="$(LiveSplitComponentsPath)" />

    <Copy
      SourceFiles="$(TargetPath)"
      DestinationFolder="$(LiveSplitComponentsPath)"
      SkipUnchangedFiles="true" />

  </Target>
</Project>
